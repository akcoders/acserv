APP_NAME="ACServ ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PUBLIC_TENANT_SLUG=acserv-demo
ACSERV_WEB_ROOT=
DEMO_WORKSPACE=acserv-demo
DEMO_OWNER_EMAIL=owner@acserv.test
DEMO_TECHNICIAN_EMAIL=technician@acserv.test
DEMO_CUSTOMER_EMAIL=customer@acserv.test

APP_LOCALE=en_IN
APP_FALLBACK_LOCALE=en_IN
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acserv_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
ATTENDANCE_GEOFENCE_METRES=250
NEXT_SERVICE_INTERVAL_MONTHS=3
SERVICE_REMINDER_ADVANCE_DAYS=7
WARRANTY_REMINDER_ADVANCE_DAYS=30
LEAVE_OPENING_DAYS=12

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
